{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "DISABLE_ADS_STUB": "true"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "DISABLE_ADS_STUB": "true",
        "EXPO_PUBLIC_ADS_READY": "false"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
